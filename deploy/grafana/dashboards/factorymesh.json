{
  "uid": "factorymesh",
  "title": "FactoryMesh ingestion reliability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Events per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "factorymesh-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(factorymesh_events_total[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Processing p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "factorymesh-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(factorymesh_processing_seconds_bucket[1m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Bounded queue occupancy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "factorymesh-prometheus"
      },
      "targets": [
        {
          "expr": "factorymesh_queue_depth",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Database retries per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "factorymesh-prometheus"
      },
      "targets": [
        {
          "expr": "rate(factorymesh_retries_total[1m])",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Resident memory bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "factorymesh-prometheus"
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Goroutines",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "factorymesh-prometheus"
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
